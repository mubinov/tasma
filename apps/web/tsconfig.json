{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "noEmit": true,
    // Vite resolves the module graph, so this project overrides the base
    // NodeNext pair together, as tsconfig.base.json anticipates.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Renderer code gets no Node type definitions, so a Node API fails to
    // typecheck here. vite/client is also what declares the *.css module.
    "types": ["vite/client"]
  },
  "include": ["src"]
}
