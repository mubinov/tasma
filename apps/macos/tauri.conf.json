{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tasma",
  "version": "../../package.json",
  "identifier": "dev.tasma.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @tasma/web dev",
    "beforeBuildCommand": "pnpm --filter @tasma/web build",
    "devUrl": "http://127.0.0.1:8276",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/tasma-daemon", "binaries/tasma-cli"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.5",
      "entitlements": "Entitlements.plist"
    }
  }
}
