{
  "name": "@tasma/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tasma-daemon": "./dist/tasma-daemon.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@agentclientprotocol/sdk": "catalog:",
    "@tasma/engine": "workspace:*",
    "@tasma/protocol": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
