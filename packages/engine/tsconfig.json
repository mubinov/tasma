{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "noEmit": true,
    // Named, so src sees only the @types packages this manifest declares and
    // not whatever is installed at the workspace root. tsconfig.test.json takes
    // these options and adds the test files to them.
    "types": ["node"]
  },
  "include": ["src"]
}
