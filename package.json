{
  "name": "tasma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tasma/web dev",
    "dev:cli": "pnpm --filter @tasma/cli --filter @tasma/daemon build >&2 && scripts/dev-home.sh node \"$PWD/apps/cli/dist/tasma.js\"",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "app:dev": "scripts/app-binaries.sh && TASMA_DEV_SERVER=1 TAURI_APP_PATH=apps/macos tauri dev",
    "app:start": "pnpm --filter @tasma/web build && scripts/app-binaries.sh && scripts/dev-home.sh cargo run --manifest-path \"$PWD/apps/macos/Cargo.toml\" --features custom-protocol",
    "app:test": "scripts/app-binaries.sh && cargo test --manifest-path apps/macos/Cargo.toml",
    "app:build": "scripts/app-binaries.sh && TAURI_APP_PATH=apps/macos tauri build",
    "app:release": "scripts/app-release.sh"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tasma/cli": "workspace:*",
    "@tasma/engine": "workspace:*",
    "@tasma/protocol": "workspace:*",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
